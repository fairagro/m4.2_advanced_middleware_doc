  "cards": [
    {
      "dot": "emerald",
      "title": "Contract",
      "items": [
        "Authoritative contract: docs/sql_to_arc_database_views.md",
        "Converter validates six views in order via models.__view_name__",
        "One vInvestigation.identifier \u2192 one ARC; other views enrich it"
      ]
    },
    {
      "dot": "amber",
      "title": "Non-SQL links",
      "items": [
        "Assay\u2194Study uses study_ref JSON array, not a SQL FK",
        "Publication / Contact / Annotation use polymorphic target_type + target_ref",
        "Empty views are allowed; required columns must be non-NULL when rows exist"
      ]
    }
  ]
