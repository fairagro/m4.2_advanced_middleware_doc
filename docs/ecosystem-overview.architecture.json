  "cards": [
    {
      "dot": "emerald",
      "title": "Producers",
      "items": [
        "Harvester harvests an RDI catalog and maps it to RO-Crate ARCs",
        "SQL-to-ARC runs inside an RDI, queries its SQL views, and builds RO-Crate ARCs",
        "Both upload ARCs into the Middleware API; the API does not harvest"
      ]
    },
    {
      "dot": "cyan",
      "title": "Core",
      "items": [
        "Middleware API accepts uploaded ARCs, stores them, and publishes asynchronously",
        "DataHUB holds ARC repos and the consolidated catalog"
      ]
    },
    {
      "dot": "amber",
      "title": "Consumers",
      "items": [
        "SearchHUB and SciWin are parallel consumers of DataHUB",
        "Neither consumer is implemented in these middleware repositories"
      ]
    }
  ]
