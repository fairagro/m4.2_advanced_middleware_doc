  "cards": [
    {
      "dot": "emerald",
      "title": "Processes vs library",
      "items": [
        "Two processes: API and Worker",
        "BusinessLogic is library code in each process \u2014 not its own runtime",
        "Shared across processes: DocumentStore (CouchDB) and RabbitMQ"
      ]
    },
    {
      "dot": "amber",
      "title": "Async boundary",
      "items": [
        "API process: store + enqueue (full ARC JSON-LD in ArcSyncTask)",
        "Worker process: ARCtrl \u2192 ArcStore; CouchDB for events only",
        "Short labels: harvest/arc are the HTTP posts; create/upsert map to create_harvest / create_or_update_arc; queue carries full ARC JSON-LD"
      ]
    }
  ]
